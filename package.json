{
  "name": "dsh-jev-decision-model",
  "version": "0.1.0",
  "description": "决策模型 Jev — structured decisions for iPolloWork and DeepSeek Harness",
  "author": "iPolloWork",
  "type": "module",
  "private": true,
  "main": "./service/dsh.mjs",
  "exports": {
    ".": "./service/dsh.mjs",
    "./client": "./service/jev.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@11.4.0",
  "files": [
    "service",
    "skills",
    "assets/jev.png",
    "ipollowork.plugin.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/jev.test.mjs",
    "test:dsh": "node --test tests/dsh.test.mjs",
    "test:work": "bun test tests/work.test.ts",
    "package:work": "node scripts/package-work.mjs",
    "package:dsh": "pnpm pack --pack-destination dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Devin-AXIS/jev-decision-plugin.git"
  },
  "devDependencies": {
    "jszip": "3.10.1"
  }
}
